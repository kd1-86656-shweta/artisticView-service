# Copy to .env (git-ignored) or set in your shell / hosting provider.
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/artisticview
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# At least 32 random bytes, e.g. `openssl rand -base64 48`
APP_JWT_SECRET=
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_FRONTEND_URL=http://localhost:3000
# Sign up with this email, restart, and that account becomes the first super admin.
APP_BOOTSTRAP_SUPER_ADMIN_EMAIL=
