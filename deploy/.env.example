# Copy to /opt/artisticview/.env and fill in. Never commit the real file.
# setup-server.sh generates the passwords and secret for you.

# Public address of the site
PUBLIC_URL=https://artisticview.in
SITE_ADDRESS=artisticview.in, www.artisticview.in
# Jenkins UI (optional; needs a DNS record too). Leave empty to keep Jenkins private.
JENKINS_ADDRESS=jenkins.artisticview.in

DB_USER=artisticview
DB_PASSWORD=change-me
REDIS_PASSWORD=change-me
JWT_SECRET=change-me-at-least-64-random-characters

# First account that signs up with this email becomes super admin
SUPER_ADMIN_EMAIL=

# Group id of the host's docker group: getent group docker | cut -d: -f3
DOCKER_GID=999
